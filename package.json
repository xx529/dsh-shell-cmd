{
  "name": "dsh-shell-cmd",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "\u5728 DSH \u8f93\u5165\u6846\u8f93\u5165 /cmd <\u7ec8\u7aef\u547d\u4ee4> \u6267\u884c\u5e76\u53d1\u9001\u7ed9\u6a21\u578b\uff1b\u88f8 /cmd \u6253\u5f00\u4ea4\u4e92\u7ec8\u7aef\uff0cCtrl+Enter \u628a\u7ec8\u7aef\u5185\u5bb9\u53d1\u7ed9\u6a21\u578b\uff0c\u5bf9\u8bdd\u4e2d\u4ee5\u7ec8\u7aef\u5361\u7247\u6e32\u67d3\u3002",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "terminal.js"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check terminal.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  }
}
